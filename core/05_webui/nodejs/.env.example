# ── Per-pipeline UI server (Node) ─────────────────────────────────────────────
# Copy to `.env`. PORT and FLASK_URL are normally injected by the launcher
# (selection/server/utils/pipelines.js); set them here only for standalone runs.

# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRY=8h

PORT=3001
FLASK_URL=http://127.0.0.1:5001
NODE_ENV=development

# ── Users (simple username/password login, routes/auth.js) ────────────────────
# Add USER_<NAME>=<bcrypt-hash>. Default below is  admin / StrongPass123
#   node -e "console.log(require('bcryptjs').hashSync('YourPassword', 10))"
USER_ADMIN=$2a$10$LHWiVTG5K4K5FJiddxSQCO1KW2CK3M6bVBLU7I0J52yPIYvrAE0Zm

# ── GAD account store (PostgreSQL) ────────────────────────────────────────────
# The standalone per-bot login (gad/*.js — signup, OTP, admin accounts) is backed
# by PostgreSQL. All three bots (chips/fg/fg2) share ONE database; rows are isolated
# by a `pipeline` column, so point every bot at the same DATABASE_URL. The
# gad_users table and its constraints are created automatically on first boot.
#
#   DATABASE_URL=postgres://gad:secret@127.0.0.1:5432/gad
# Or use the standard libpq vars instead of a URL:
#   PGHOST=127.0.0.1  PGPORT=5432  PGUSER=gad  PGPASSWORD=secret  PGDATABASE=gad
# Managed Postgres needing TLS: set PGSSLMODE=require (or verify-full).
DATABASE_URL=postgres://gad:changeme@127.0.0.1:5432/gad

# First-admin seed for THIS bot (per-pipeline prefix: CHIPS_/FG_/FG2_; fg2 also
# accepts the legacy GAD_ names). Seeded once, only if no admin exists yet.
#   FG2_ADMIN_USER=admin
#   FG2_ADMIN_PASSWORD=change-this-now
#   FG2_ADMIN_EMAIL=admin@cg.gov.in

# One-time import of existing data/<bot>/auth/users.json into Postgres:
#   npm run migrate-users

# ── Email delivery (SMTP) — REQUIRED for signup + email OTP ───────────────────
# Signup confirms the account via an emailed LINK; without SMTP the link is only
# printed to the server log (mock mode) and never reaches the user. The same SMTP
# is used for email OTP login/reset. isConfigured() is true as soon as SMTP_HOST
# is set.
SMTP_HOST=smtp.your-provider.gov.in
SMTP_PORT=587                    # 465 = implicit TLS; 587 = STARTTLS
SMTP_SECURE=false                # true forces implicit TLS (or use port 465)
SMTP_USER=notifications@cg.gov.in
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=notifications@cg.gov.in   # defaults to SMTP_USER if omitted
SMTP_SENDER_NAME=GAD Governance Assistant

# Public base URL the confirmation link points at (honoured over the request host,
# so links behind the reverse proxy are correct). No trailing slash.
PIPELINE_PUBLIC_URL=https://rag.example.gov.in

# ── Mobile OTP (CDAC MSDG SMS gateway) — OPTIONAL, for SMS OTP LOGIN ──────────
# NOT used by signup (signup only stores the number). Enables passwordless SMS OTP
# login/reset. Requires GAD's own CDAC credentials AND a DLT-approved OTP template;
# the SMS text MUST match that template or the government gateway drops it.
# isConfigured() needs SMS_USERNAME + SMS_SENDER_ID + SMS_SECURE_KEY.
SMS_USERNAME=your-cdac-username
SMS_PASSWORD=your-cdac-password
SMS_SENDER_ID=CGGOVT            # your DLT-registered 6-char sender/header
SMS_SECURE_KEY=your-cdac-secure-key
SMS_OTP_TEMPLATE_ID=your-dlt-template-id
# Must match the DLT template EXACTLY; {code} and {mins} are substituted.
SMS_OTP_TEMPLATE_TEXT=Your GAD Governance Assistant OTP is {code}. Valid for {mins} minutes. Do not share it. -GAD CG
# SMS_GATEWAY_URL / SMS_SERVICE_TYPE only if CDAC gives you non-default values.

# ── OTP / signup tuning (all optional; sane defaults in code) ─────────────────
# OTP_TTL_SECONDS=600            # code lifetime (default 10 min)
# OTP_MAX_ATTEMPTS=5             # wrong-code tries before a code is burned
# OTP_DAILY_CAP=20              # codes per account per day
# OTP_RESEND_COOLDOWN_SECONDS=30
# SIGNUP_VERIFY_TTL_SECONDS=86400  # confirmation-link lifetime (default 24h)
# SIGNUP_EMAIL_DOMAINS=gov.in,nic.in  # who may self-signup (default gov.in+nic.in)
